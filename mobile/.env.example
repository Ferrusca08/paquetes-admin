# ============================================================
# PackTrack — Expo Environment Variables
# Copy to .env.local and fill in the values from terraform output
# ============================================================

# AWS Region
EXPO_PUBLIC_AWS_REGION=us-east-1

# Cognito
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
EXPO_PUBLIC_COGNITO_APP_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# AppSync GraphQL API
EXPO_PUBLIC_APPSYNC_URL=https://XXXXXXXXXXXXXXXXXXXXXXXXXX.appsync-api.us-east-1.amazonaws.com/graphql
EXPO_PUBLIC_APPSYNC_REALTIME_URL=wss://XXXXXXXXXXXXXXXXXXXXXXXXXX.appsync-realtime-api.us-east-1.amazonaws.com/graphql

# S3
EXPO_PUBLIC_S3_BUCKET=packtrack-dev-uploads-XXXXXXXXXXXX-us
